# macOS junk
.DS_Store

# Ignore all dataset contents by default
03-development/datasets/**

# Re-allow dataset directory structure
!03-development/datasets/
!03-development/datasets/**/

# Keep preprocessing scripts tracked
!03-development/datasets/**/scripts/
!03-development/datasets/**/scripts/**

# Python cache
__pycache__/
*.pyc

# experiment outputs
results/

# Model checkpoints and training logs (large / generated)
src/checkpoints/
src/logs/

# Backup files
*.backup

# Debug outputs
debug_*.png

# Documents / templates
*.docx
*.pdf